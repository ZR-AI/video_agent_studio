# Default credentials are read in-process from the existing project.
# Copy this file to .env only if you want to override these settings.
KEY_SOURCE_FILE=../fl2va/web/.dev.vars
VIDEO_AGENT_HOST=127.0.0.1
VIDEO_AGENT_PORT=8010
VIDEO_AGENT_MODEL=deepseek-chat
# auto uses DeepSeek when configured; rules is a local planner for offline checks.
VIDEO_AGENT_PLANNER=auto
PRODUCT_STUDIO_URL=http://127.0.0.1:8008
MOTION_STUDIO_URL=http://127.0.0.1:8001
# Empty: execute the FL2VA tool directly on the server, without the web server.
FL2VA_URL=
# Loaded from fl2va/web/wrangler.toml when absent. Use one matching video mode.
# RUNNINGHUB_VIDEO_WORKFLOW_ID=
# FL2VA_VIDEO_MODE=two_pass
# RH_WORKFLOW_ID=
# DEEPSEEK_API_KEY=
# RUNNINGHUB_API_KEY=
VIDEO_AGENT_WORKERS=2
